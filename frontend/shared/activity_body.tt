[%# Copyright 2026 Amir Sibaee (https://as86.pro)
    SPDX-License-Identifier: Apache-2.0
    Shared My Activity page body. Included once by each theme adapter.
    Flow: list the latest 100 recorded changes (newest first) with an
    Undo button wherever the action stored one. Undo runs the undo of
    that same tool with its stored arguments; the undo itself is
    recorded too, so the list always ends with the newest state. %]
<div class="ut-wrap">
  <p class="ut-lead">[% locale.maketext('Every change made by any tool, newest first, with Undo where one exists. Undo runs the undo of that same tool, and the undo is recorded here as well.') %]</p>
  <details class="ut-learn">
    <summary>[% locale.maketext('Learn more') %]</summary>
    <p>[% locale.maketext('Fixes, cleanups, quarantines, blocks, scheduler and shell changes are all listed here. Entries that cannot be undone (emptied trash, cleared logs) say so: those actions are final.') %]</p>
  </details>
  <div class="ut-banner warn" id="ut-banner" role="status" aria-live="polite">[% locale.maketext('Loading your recent changes.') %]</div>
  <div class="ut-lists" id="ut-lists" aria-live="polite"></div>
  <dialog class="ut-dialog" id="ut-dialog" aria-labelledby="ut-dialog-title">
    <h2 id="ut-dialog-title"></h2>
    <p id="ut-dialog-body"></p>
    <div class="ut-dialog-actions">
      <button class="ut-btn" id="ut-dialog-apply" type="button"></button>
      <button class="ut-btn secondary" id="ut-dialog-cancel" type="button">[% locale.maketext('Cancel') %]</button>
    </div>
  </dialog>
[% PROCESS 'shared/footer.tt' -%]
</div>
<script>
var UT_STR = {
    noneFound: "[% locale.maketext('No changes recorded yet.') %]",
    failed: "[% locale.maketext('Could not load the list. Please try again.') %]",
    undo: "[% locale.maketext('Undo') %]",
    noUndo: "[% locale.maketext('Final (cannot be undone)') %]",
    undone: "[% locale.maketext('Undone here already') %]",
    confirmTitle: "[% locale.maketext('Confirm undo') %]",
    confirmBody: "[% locale.maketext("Undo this change? It runs that tool's own undo.") %]",
    confirmApply: "[% locale.maketext('Undo now') %]",
    undoneBanner: "[% locale.maketext('Undone.') %]",
    undoFailed: "[% locale.maketext('Undo failed: ') %]",
    refreshed: "[% locale.maketext('List refreshed.') %]"
};
</script>
<script>
"use strict";
window.addEventListener("DOMContentLoaded", function () {
    if (!window.UserTools) {
        document.getElementById("ut-banner").textContent = "UserTools failed to load.";
        return;
    }
    var TOOLS = {
        fix_home: "Fix Home", bulk_perms: "Bulk Permissions", shell: "Shell",
        space_cleaner: "Space Cleaner", site_doctor: "Site Doctor",
        exposed_files: "Exposed Files", app_helper: "App Helper",
        cron_doctor: "Cron Doctor"
    };
    var bannerEl = document.getElementById("ut-banner");
    var listsEl = document.getElementById("ut-lists");
    var dlg = document.getElementById("ut-dialog");
    var dlgTitle = document.getElementById("ut-dialog-title");
    var dlgBody = document.getElementById("ut-dialog-body");
    var dlgApply = document.getElementById("ut-dialog-apply");
    var dlgCancel = document.getElementById("ut-dialog-cancel");
    var lastApply = null;
    var lastFocus = null;
    var undoneIdx = {};
    // Undo entry points the page may call: exactly the fn values the
    // server stores in activity undo refs. Anything else is never sent.
    var UT_ALLOW = {
        cron_undo: 1, home_permissions_undo: 1, bulk_permissions_undo: 1,
        space_trash_restore: 1, doctor_htaccess_undo: 1,
        doctor_xmlrpc_undo: 1,
        exposed_restore: 1, exposed_block: 1,
        exposed_unblock: 1, app_helper_undo_docroot: 1,
        app_helper_htaccess_undo: 1,
        app_helper_cron_add: 1, app_helper_cron_remove: 1,
        app_helper_remove: 1, app_helper_add: 1,
        app_helper_primary_set: 1, app_helper_production_undo: 1
    };

    function setBanner(kind, text) {
        bannerEl.className = "ut-banner " + kind;
        bannerEl.textContent = text;
    }
    function escTool(t) {
        return UserTools.escHtml(TOOLS[t] || t || "?");
    }
    function escSummary(s) {
        s = s || {};
        var bits = [];
        Object.keys(s).forEach(function (k) {
            if (k === "job_id" || k === "trash_batch" || k === "batch") { return; }
            bits.push(k + ": " + s[k]);
        });
        return UserTools.escHtml(bits.join(", "));
    }
    function openDialog(title, body, applyLabel, onApply) {
        lastFocus = document.activeElement;
        dlgTitle.textContent = title;
        dlgBody.textContent = body;
        dlgApply.textContent = applyLabel;
        lastApply = onApply;
        if (dlg.showModal) { dlg.showModal(); } else { dlg.setAttribute("open", ""); }
        dlgCancel.focus();
    }
    function closeDialog() {
        if (dlg.close) { dlg.close(); } else { dlg.removeAttribute("open"); }
        lastApply = null;
        if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
    }
    dlgApply.addEventListener("click", function () {
        var fn = lastApply;
        closeDialog();
        if (fn) { fn(); }
    });
    dlgCancel.addEventListener("click", closeDialog);
    function canUndo(e) {
        return e && e.undo && e.undo.fn && UT_ALLOW[e.undo.fn];
    }
    function refresh() {
        UserTools.callApi("activity_list", {}, "GET").then(function (data) {
            renderResult(data || {});
        }).catch(function (err) {
            setBanner("err", UT_STR.failed + " " + err.message);
        });
    }
    function renderResult(data, keepBanner) {
        var entries = data.entries || [];
        if (!entries.length) {
            setBanner("ok", UT_STR.noneFound);
            listsEl.innerHTML = "";
            return;
        }
        if (!keepBanner) {
            setBanner("ok", UT_STR.refreshed);
        }
        var html = '<table class="ut-table"><thead><tr><th>When</th><th>Tool</th><th>What</th><th></th></tr></thead><tbody>';
        entries.forEach(function (e, i) {
            html += "<tr><td>" + UserTools.escHtml(e.time || "?") + "</td><td>" +
                escTool(e.tool) + "<br><span class=\"ut-path\">" +
                UserTools.escHtml(e.action || "") + "</span><br><span class=\"ut-path\">" +
                escSummary(e.summary) + "</span></td><td>";
            if (undoneIdx[i]) {
                html += UserTools.escHtml(UT_STR.undone);
            } else if (canUndo(e)) {
                html += '<button class="ut-btn small secondary" type="button" data-undo="' + i + '">' +
                    UserTools.escHtml(UT_STR.undo) + "</button>";
            } else {
                html += UserTools.escHtml(UT_STR.noUndo);
            }
            html += "</td></tr>";
        });
        listsEl.innerHTML = html + "</tbody></table>";
        Array.prototype.forEach.call(listsEl.querySelectorAll("[data-undo]"), function (btn) {
            btn.addEventListener("click", function () {
                var idx = Number(btn.getAttribute("data-undo"));
                var e = entries[idx];
                if (!canUndo(e)) { return; }
                openDialog(UT_STR.confirmTitle,
                    UT_STR.confirmBody + " [" + (TOOLS[e.tool] || e.tool) + ": " + (e.action || "") + "]",
                    UT_STR.confirmApply,
                    function () { applyUndo(entries, idx); });
            });
        });
        function applyUndo(list, idx) {
            var e = list[idx];
            if (!canUndo(e)) { return; }
            UserTools.callApi(e.undo.fn, e.undo.args || {}, "POST").then(function () {
                undoneIdx[idx] = true;
                renderResult({ entries: list }, true);
                setBanner("ok", UT_STR.undoneBanner);
            }).catch(function (err) {
                setBanner("err", UT_STR.undoFailed + err.message);
            });
        }
    }
    refresh();
});
</script>
