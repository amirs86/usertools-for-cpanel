# UserTools for cPanel — log rotation for /var/log/usertools.log.
# Installed as /etc/logrotate.d/usertools (0644) by install.sh and refreshed
# on upgrade; removed by uninstall.sh (even without --purge).
/var/log/usertools.log {
    weekly
    rotate 12
    compress
    missingok
    notifempty
    create 0600 root root
}
